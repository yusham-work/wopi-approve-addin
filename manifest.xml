<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<OfficeApp
  xmlns="http://schemas.microsoft.com/office/appforoffice/1.1"
  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  xmlns:bt="http://schemas.microsoft.com/office/officeappbasictypes/1.0"
  xsi:type="TaskPaneApp">

  <Id>8d5e5f8a-6f3b-4f0e-9c21-123456789abc</Id>

  <Version>1.0.0.0</Version>

  <ProviderName>My Application</ProviderName>

  <DefaultLocale>en-US</DefaultLocale>

  <DisplayName DefaultValue="My Application" />

  <Description DefaultValue="My Application Office Add-in" />

  <IconUrl DefaultValue="https://myapp.example.com/office-addin/icon-32.png" />
  <SupportUrl DefaultValue="https://myapp.example.com" />

  <Hosts>
    <Host Name="Workbook" />
  </Hosts>

  <Requirements>
    <Sets>
      <Set Name="ExcelApi" MinVersion="1.1" />
    </Sets>
  </Requirements>

  <DefaultSettings>
    <SourceLocation
      DefaultValue="https://myapp.example.com/office-addin/taskpane.html" />
  </DefaultSettings>

  <Permissions>ReadWriteDocument</Permissions>

  <VersionOverrides
    xmlns="http://schemas.microsoft.com/office/taskpaneappversionoverrides"
    xsi:type="VersionOverridesV1_0">

    <Requirements>
      <bt:Sets DefaultMinVersion="1.3">
        <bt:Set Name="AddinCommands" />
      </bt:Sets>
    </Requirements>

    <Hosts>
      <Host xsi:type="Workbook">
        <DesktopFormFactor>

          <!-- JavaScript-файл для команд -->
          <FunctionFile resid="Commands.Url" />

          <!-- Додаємо кнопку -->
          <ExtensionPoint xsi:type="PrimaryCommandSurface">

            <OfficeTab id="TabHome">

              <Group id="MyApplicationGroup">

                <Label resid="GroupLabel" />

                <Control
                  xsi:type="Button"
                  id="ApproveButton">

                  <Label resid="ApproveButton.Label" />

                  <Supertip>
                    <Title resid="ApproveButton.Label" />
                    <Description resid="ApproveButton.Description" />
                  </Supertip>

                  <Icon>
                    <bt:Image size="16"
                      resid="Icon16" />
                    <bt:Image size="32"
                      resid="Icon32" />
                    <bt:Image size="80"
                      resid="Icon80" />
                  </Icon>

                  <Action xsi:type="ExecuteFunction">
                    <FunctionName>
                      approveDocument
                    </FunctionName>
                  </Action>

                </Control>

              </Group>

            </OfficeTab>

          </ExtensionPoint>

        </DesktopFormFactor>
      </Host>
    </Hosts>

    <Resources>

      <bt:Images>

        <bt:Image
          id="Icon16"
          DefaultValue="https://myapp.example.com/office-addin/icon-16.png" />

        <bt:Image
          id="Icon32"
          DefaultValue="https://myapp.example.com/office-addin/icon-32.png" />

        <bt:Image
          id="Icon80"
          DefaultValue="https://myapp.example.com/office-addin/icon-80.png" />

      </bt:Images>

      <bt:Urls>

        <bt:Url
          id="Commands.Url"
          DefaultValue="https://myapp.example.com/office-addin/commands.html" />

      </bt:Urls>

      <bt:ShortStrings>

        <bt:String
          id="GroupLabel"
          DefaultValue="My Application" />

        <bt:String
          id="ApproveButton.Label"
          DefaultValue="Погодити" />

      </bt:ShortStrings>

      <bt:LongStrings>

        <bt:String
          id="ApproveButton.Description"
          DefaultValue="Погодити поточний документ" />

      </bt:LongStrings>

    </Resources>

  </VersionOverrides>

</OfficeApp>
